# ---------------------------------------------------------------------------
# Vertex AI + 서비스 계정 키(JSON)로 인증 (로컬/서버 공통 패턴)
# ---------------------------------------------------------------------------
# 키 파일 경로는 절대 경로 권장. 예: /Users/me/keys/didimtest006-adk.json
GOOGLE_APPLICATION_CREDENTIALS=

GOOGLE_CLOUD_PROJECT=didimtest006
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# Gemini 모델 (Vertex 게시 모델 ID)
MODEL=gemini-2.5-flash

# Vertex를 쓸 때는 API 키 경로와 동시에 쓰지 마세요.
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 대안: Google AI Studio API 키만 (Vertex / GCP IAM 불필요)
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_API_KEY=
